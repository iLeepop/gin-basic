# app
APP_ENV=dev
APP_NAME=gin-basic
APP_VERSION=0.0.1
APP_API_HOST=127.0.0.1
APP_API_PORT=8080

# log
LOG_LEVEL=info
LOG_OUTPUT=both

# database.mysql
DATABASE_MYSQL_HOST=
DATABASE_MYSQL_PORT=3306
DATABASE_MYSQL_USERNAME=root
DATABASE_MYSQL_PASSWORD=
DATABASE_MYSQL_DATABASE=gin_basic

# database.postgresql
DATABASE_POSTGRESQL_HOST=
DATABASE_POSTGRESQL_PORT=5432
DATABASE_POSTGRESQL_USERNAME=postgres
DATABASE_POSTGRESQL_PASSWORD=
DATABASE_POSTGRESQL_DATABASE=gin_basic

# cache.redis
CACHE_REDIS_HOST=
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=

# jwt
JWT_SECRET=change_me_in_production
